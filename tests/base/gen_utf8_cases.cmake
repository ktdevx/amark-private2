#
# The generator of the data-driven UTF-8 test vectors (4.7, 13.1, 13.2). Run by
# amark_add_generated_tests() at build time, in script mode:
#
#   cmake -DAMARK_TESTGEN_INPUT=<data> -DAMARK_TESTGEN_OUTPUT=<c>
#         -DAMARK_TESTGEN_SUITE=<suite> -DAMARK_TESTGEN_MODULE=<AmarkTestGen.cmake>
#         -P gen_utf8_cases.cmake
#
# Reads the data lines of <data> (the format is described at the top of
# data/utf8_cases.txt)
#   <name> | <input> | <expected>
# and writes the suite <suite> with one test <name> per data line. Each test
# decodes the input from its start with amark_utf8_decode, one character after
# the other, from a heap block of exactly the input's size (so that a read past
# the length is caught by AddressSanitizer), and checks the code point and the
# consumed bytes of every character, that the characters cover the whole input,
# that a NULL out_codepoint gives the same length, and that the input is left
# unchanged.
#
# A malformed data line stops the build with its line number: an invalid name or
# a duplicate one, bytes that are not hexadecimal, an expectation that is not
# U+<hex>/<1-4>, or consumed bytes that do not add up to the input length.

cmake_minimum_required(VERSION 3.21)

include("${AMARK_TESTGEN_MODULE}")

set(suite "${AMARK_TESTGEN_SUITE}")
get_filename_component(input_name "${AMARK_TESTGEN_INPUT}" NAME)

function(fail_line number message)
  message(FATAL_ERROR "${AMARK_TESTGEN_INPUT}:${number}: ${message}")
endfunction()

# The text of a data line given as hexadecimal. Only printable ASCII (and tab) is
# accepted, without the characters that CMake lists and strings treat specially.
function(line_text out_var number hex)
  string(LENGTH "${hex}" digits)
  set(text "")
  set(i 0)
  while(i LESS digits)
    string(SUBSTRING "${hex}" ${i} 2 byte_hex)
    math(EXPR byte "0x${byte_hex}")
    if(NOT (byte EQUAL 9 OR (byte GREATER_EQUAL 32 AND byte LESS 127))
        OR byte EQUAL 34 OR byte EQUAL 59 OR byte EQUAL 91 OR byte EQUAL 92
        OR byte EQUAL 93)
      fail_line(${number} "byte 0x${byte_hex} is not allowed in the data (see the format)")
    endif()
    string(ASCII ${byte} char)
    string(APPEND text "${char}")
    math(EXPR i "${i} + 2")
  endwhile()
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

amark_testgen_read_lines_hex(lines "${AMARK_TESTGEN_INPUT}")

set(code "/* SPDX-License-Identifier: MIT
 * Copyright (c) The Amark Authors */

/* Generated by tests/base/gen_utf8_cases.cmake from ${input_name}. Do not edit. */
#include <amark/amark.h>

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include <naos/naos.h>

typedef struct utf8_case_step {
    uint32_t codepoint;
    size_t length;
} utf8_case_step_t;

/*
 * Decodes input from its start, one character after the other, and checks each
 * character against steps (13.1, 13.2).
 */
static void check_case(const unsigned char *input, size_t size,
                       const utf8_case_step_t *steps, size_t step_count)
{
    char *text = (char *)malloc(size);
    size_t offset = 0;
    size_t i;

    if (text == NULL) {
        NAOS_FAIL(\"out of memory\");
    }
    memcpy(text, input, size);

    for (i = 0; i < step_count && offset < size; i++) {
        uint32_t codepoint = 0xDEADBEEFu;
        size_t length;

        NAOS_TRACE_PUSH(\"character %u at offset %u\", (unsigned)i, (unsigned)offset);
        length = amark_utf8_decode(text + offset, size - offset, &codepoint);
        NAOS_CHECK_UINT_EQ(steps[i].length, length);
        NAOS_CHECK_UINT_EQ(steps[i].codepoint, codepoint);
        NAOS_CHECK_UINT_EQ(length, amark_utf8_decode(text + offset, size - offset, NULL));
        NAOS_TRACE_POP();
        if (length == 0 || length > size - offset) {
            break;
        }
        offset += length;
    }
    /* Every expected character was decoded, and they cover the whole input. */
    NAOS_CHECK_UINT_EQ(step_count, i);
    NAOS_CHECK_UINT_EQ(size, offset);
    NAOS_CHECK_MEM_EQ(text, size, input, size);
    free(text);
}

")
set(tests "")
set(names "")
set(number 0)
foreach(hex IN LISTS lines)
  math(EXPR number "${number} + 1")
  # Comment lines (a "#" after optional blanks) are skipped before the text is
  # checked, so that they may hold any character.
  if(hex MATCHES "^((20|09)(20|09)*)?23")
    continue()
  endif()
  line_text(line ${number} "${hex}")
  string(STRIP "${line}" line)
  if(line STREQUAL "")
    continue()
  endif()

  if(NOT line MATCHES "^([^|]*)\\|([^|]*)\\|([^|]*)$")
    fail_line(${number} "expected <name> | <input> | <expected>")
  endif()
  string(STRIP "${CMAKE_MATCH_1}" name)
  string(STRIP "${CMAKE_MATCH_2}" input)
  string(STRIP "${CMAKE_MATCH_3}" expected)

  if(NOT name MATCHES "^[a-z_][a-z0-9_]*$")
    fail_line(${number} "the name '${name}' is not [a-z_][a-z0-9_]*")
  endif()
  if(name IN_LIST names)
    fail_line(${number} "the name '${name}' is used twice")
  endif()
  list(APPEND names "${name}")

  # The input: hexadecimal bytes separated by spaces.
  string(REGEX REPLACE "[ \t]+" ";" input_bytes "${input}")
  set(input_hex "")
  foreach(byte IN LISTS input_bytes)
    if(NOT byte MATCHES "^[0-9a-fA-F][0-9a-fA-F]$")
      fail_line(${number} "'${byte}' in the input is not a hexadecimal byte")
    endif()
    string(APPEND input_hex "${byte}")
  endforeach()
  string(LENGTH "${input_hex}" digits)
  math(EXPR size "${digits} / 2")
  if(size EQUAL 0)
    fail_line(${number} "the input has no byte")
  endif()

  # The expectation: U+<hex>/<length> for each character.
  string(REGEX REPLACE "[ \t]+" ";" expected_steps "${expected}")
  set(steps "")
  set(step_count 0)
  set(total 0)
  foreach(step IN LISTS expected_steps)
    if(NOT step MATCHES "^U\\+([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]?[0-9A-Fa-f]?)/([1-4])$")
      fail_line(${number} "'${step}' is not U+<4-6 hexadecimal digits>/<1-4>")
    endif()
    string(TOUPPER "${CMAKE_MATCH_1}" codepoint)
    set(length "${CMAKE_MATCH_2}")
    string(APPEND steps "    {0x${codepoint}u, ${length}},\n")
    math(EXPR step_count "${step_count} + 1")
    math(EXPR total "${total} + ${length}")
  endforeach()
  if(step_count EQUAL 0)
    fail_line(${number} "the expectation has no character")
  endif()
  if(NOT total EQUAL size)
    fail_line(${number}
      "the consumed bytes add up to ${total}, but the input has ${size} bytes")
  endif()
  string(REGEX REPLACE ",\n$" "\n" steps "${steps}")

  amark_testgen_c_string(note "${input} -> ${expected}")
  amark_testgen_byte_array(array NAME input_${name} HEX "${input_hex}")
  string(APPEND code "/* ${input_name}:${number} */
${array}static const utf8_case_step_t steps_${name}[] = {
${steps}};

NAOS_TEST(${name})
{
    NAOS_TRACE_PUSH(\"%s\", ${note});
    check_case(input_${name}, input_${name}_size, steps_${name},
               sizeof steps_${name} / sizeof steps_${name}[0]);
    NAOS_TRACE_POP();
}

")
  string(APPEND tests "    NAOS_ADD_TEST(${name}),\n")
endforeach()

if(tests STREQUAL "")
  message(FATAL_ERROR "${AMARK_TESTGEN_INPUT}: no data line")
endif()

# The last entry has no comma.
string(REGEX REPLACE ",\n$" "\n" tests "${tests}")
string(APPEND code "NAOS_SUITE(${suite},
${tests})
")

amark_testgen_write("${AMARK_TESTGEN_OUTPUT}" "${code}")
