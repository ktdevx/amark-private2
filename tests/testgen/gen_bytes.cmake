#
# The generator of the self-test of the test generation (4.7, 4.8). Run by
# amark_add_generated_tests() at build time, in script mode:
#
#   cmake -DAMARK_TESTGEN_INPUT=<data> -DAMARK_TESTGEN_OUTPUT=<c>
#         -DAMARK_TESTGEN_SUITE=<suite> -DAMARK_TESTGEN_MODULE=<AmarkTestGen.cmake>
#         -P gen_bytes.cmake
#
# Writes the suite <suite> with:
#   - one test per line of <data>, line_<n> (from 1): the bytes of the line, read
#     with amark_testgen_read_lines_hex(), are the bytes of the whole file, read
#     separately, at the offset of the line, and LF or the end of the file follows;
#   - joined_lines_are_the_file: the lines joined with LF are the whole file;
#   - the checks of the helpers that do not depend on <data> (c_string_*,
#     c_identifier_*, lines_*);
# and the functions that testgen_test.c uses to compare the lines and the file
# with the literals written there:
#   size_t <suite>_line_count(void);
#   const unsigned char *<suite>_line(size_t index, size_t *size);
#   const unsigned char *<suite>_file(size_t *size);

cmake_minimum_required(VERSION 3.21)

include("${AMARK_TESTGEN_MODULE}")

set(suite "${AMARK_TESTGEN_SUITE}")
get_filename_component(input_name "${AMARK_TESTGEN_INPUT}" NAME)

amark_testgen_read_lines_hex(lines "${AMARK_TESTGEN_INPUT}")
file(READ "${AMARK_TESTGEN_INPUT}" file_hex HEX)

set(code "/* SPDX-License-Identifier: MIT
 * Copyright (c) The Amark Authors */

/* Generated by tests/testgen/gen_bytes.cmake from ${input_name}. Do not edit. */
#include <stddef.h>

#include <naos/naos.h>

")
set(tests "")

amark_testgen_byte_array(array NAME whole HEX "${file_hex}")
string(APPEND code "${array}\n")

# One array and one test per line.
set(count 0)
set(offset 0)
set(cases "")
foreach(hex IN LISTS lines)
  math(EXPR count "${count} + 1")
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  amark_testgen_byte_array(array NAME line_${count} HEX "${hex}")
  string(APPEND code "${array}
NAOS_TEST(line_${count})
{
    /* Line ${count}, at the offset ${offset} of the file. */
    NAOS_REQUIRE_UINT_LE(${offset} + line_${count}_size, whole_size);
    NAOS_CHECK_MEM_EQ(whole + ${offset}, line_${count}_size, line_${count}, line_${count}_size);
    if (${offset} + line_${count}_size < whole_size) {
        NAOS_CHECK_UINT_EQ(0x0a, whole[${offset} + line_${count}_size]);
    }
}

")
  string(APPEND tests "    NAOS_ADD_TEST(line_${count}),\n")
  math(EXPR index "${count} - 1")
  string(APPEND cases "    case ${index}:
        *size = line_${count}_size;
        return line_${count};
")
  math(EXPR offset "${offset} + ${size} + 1")
endforeach()

# The lines joined with LF, and the LF that ends the file if there is one.
amark_testgen_join_lines_hex(joined "${lines}")
if(file_hex MATCHES "0a$" AND NOT joined STREQUAL "")
  string(APPEND joined "0a")
elseif(file_hex STREQUAL "0a")
  # One empty line: the CMake list of the lines is empty (see AmarkTestGen.cmake).
  set(joined "0a")
endif()
amark_testgen_byte_array(array NAME joined HEX "${joined}")
string(APPEND code "${array}
NAOS_TEST(joined_lines_are_the_file)
{
    NAOS_CHECK_MEM_EQ(joined, joined_size, whole, whole_size);
}

")
string(APPEND tests "    NAOS_ADD_TEST(joined_lines_are_the_file),\n")

# amark_testgen_c_string(): the literal holds the same bytes as amark_testgen_hex()
# gives for the same text, with the characters that C or CMake treat specially.
string(ASCII 1 control)
string(ASCII 127 delete)
set(text "tab\t cr\r lf\n quote\" backslash\\ trigraph??= ;[[]] \${x} @x@ ${control}${delete}1 end")
amark_testgen_c_string(literal "${text}")
amark_testgen_hex(text_hex "${text}")
amark_testgen_byte_array(array NAME c_string_bytes HEX "${text_hex}")
amark_testgen_c_string(empty_literal "")
string(APPEND code "${array}
NAOS_TEST(c_string_matches_hex)
{
    static const char literal[] = ${literal};

    NAOS_CHECK_MEM_EQ(literal, sizeof literal - 1, c_string_bytes, c_string_bytes_size);
    NAOS_CHECK_STR_EQ(\"\", ${empty_literal});
}

")
string(APPEND tests "    NAOS_ADD_TEST(c_string_matches_hex),\n")

# amark_testgen_c_identifier().
set(checks "")
function(check_identifier name expected)
  amark_testgen_c_identifier(identifier "${name}")
  amark_testgen_c_string(identifier_literal "${identifier}")
  string(APPEND checks "    NAOS_CHECK_STR_EQ(\"${expected}\", ${identifier_literal});\n")
  set(checks "${checks}" PARENT_SCOPE)
endfunction()
check_identifier("ok_Name9" "ok_Name9")
check_identifier("1st line-name.txt" "_1st_line_name_txt")
check_identifier("a;b[c]" "a_b_c_")
check_identifier("" "_")
string(APPEND code "NAOS_TEST(c_identifier_examples)
{
${checks}}

")
string(APPEND tests "    NAOS_ADD_TEST(c_identifier_examples),\n")

# amark_testgen_read_lines_hex() on files written here: a final LF ends the last
# line and adds no empty line; an empty file has no line.
# The file is written with NEWLINE_STYLE UNIX: file(WRITE) of the MSYS2 build of
# CMake writes CR LF for "\n", which would put a CR in the lines.
set(scratch "${AMARK_TESTGEN_OUTPUT}.lines.tmp")
file(CONFIGURE OUTPUT "${scratch}" CONTENT "a\n\nb\n" @ONLY NEWLINE_STYLE UNIX)
amark_testgen_read_lines_hex(lf_lines "${scratch}")
list(LENGTH lf_lines lf_count)
amark_testgen_join_lines_hex(lf_joined "${lf_lines}")
amark_testgen_c_string(lf_joined_literal "${lf_joined}")
file(WRITE "${scratch}" "")
amark_testgen_read_lines_hex(empty_lines "${scratch}")
list(LENGTH empty_lines empty_count)
file(REMOVE "${scratch}")
string(APPEND code "NAOS_TEST(lines_end_at_lf)
{
    NAOS_CHECK_UINT_EQ(3, ${lf_count});
    NAOS_CHECK_STR_EQ(\"610a0a62\", ${lf_joined_literal});
    NAOS_CHECK_UINT_EQ(0, ${empty_count});
}

")
string(APPEND tests "    NAOS_ADD_TEST(lines_end_at_lf),\n")

# The functions used by testgen_test.c.
string(APPEND code "size_t ${suite}_line_count(void);
size_t ${suite}_line_count(void)
{
    return ${count};
}

const unsigned char *${suite}_line(size_t index, size_t *size);
const unsigned char *${suite}_line(size_t index, size_t *size)
{
    switch (index) {
${cases}    default:
        *size = 0;
        return NULL;
    }
}

const unsigned char *${suite}_file(size_t *size);
const unsigned char *${suite}_file(size_t *size)
{
    *size = whole_size;
    return whole;
}

")

# The last entry has no comma.
string(REGEX REPLACE ",\n$" "\n" tests "${tests}")
string(APPEND code "NAOS_SUITE(${suite},
${tests})
")

amark_testgen_write("${AMARK_TESTGEN_OUTPUT}" "${code}")
